generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  SUPERADMIN
  ADMIN
  COMERCIAL
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

model Page {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  figmaFileKey String
  figmaNodeId  String
  status       PageStatus @default(DRAFT)
  // SEO (replaces Rank Math per-page meta)
  metaTitle       String?
  metaDescription String? @db.Text
  ogImage         String?
  canonical       String?
  noindex         Boolean @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

/// Editable key/value site configuration (GTM id, default currency, etc.).
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// Transactional email transport config (singleton row, id = "singleton").
/// `config` holds the encrypted JSON credentials (Resend API key); the from
/// name/address are non-sensitive and kept as plain columns.
model EmailSettings {
  id        String   @id @default("singleton")
  fromEmail String   @default("")
  fromName  String   @default("")
  // Encrypted JSON, e.g. {"apiKey":"re_..."}. MySQL TEXT has no DEFAULT, so the
  // empty-encrypted default is written in code (see settings action).
  config    String   @db.Text
  updatedAt DateTime @updatedAt
}

/// A transactional email whose subject/HTML the admin edits. `key` matches an
/// entry in the email template catalog (src/lib/email/templates.ts), which maps
/// it to the order event that triggers it (PAID/FAILED/REFUNDED).
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  subject   String
  html      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// URL redirects (replaces the Redirection plugin). Applied in proxy.ts.
model Redirect {
  id         String   @id @default(cuid())
  from       String   @unique // incoming path, e.g. "/old-page"
  to         String // destination path or absolute URL
  statusCode Int      @default(301)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([enabled])
}

model Currency {
  id        String         @id @default(cuid())
  code      String         @unique // ISO 4217, e.g. EUR, MXN, USD
  name      String // e.g. "Euro"
  symbol    String // e.g. "€"
  enabled   Boolean        @default(true)
  // CSV of ISO-3166 alpha-2 country codes that resolve to this currency,
  // e.g. "MX" or "ES,IT,FR". Used to pick a currency by visitor country.
  countryCodes String @default("")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  prices    ProductPrice[]
  gateways  GatewayCurrency[]
  orders    Order[]

  @@index([name]) // search by name (code is already unique-indexed)
  @@index([enabled]) // filter by status
}

/// Product category (editable from the admin panel).
model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  visible     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([visible])
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  sku         String?
  description String         @db.Text
  academyId   String         @default("") // external academy identifier
  visible     Boolean        @default(true)
  featured    Boolean        @default(false)
  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  prices      ProductPrice[]
  images      ProductImage[]

  @@index([name]) // search by name
  @@index([updatedAt]) // default sort
  @@index([slug])
  @@index([visible])
  @@index([categoryId])
}

/// Product image hosted on Bunny CDN.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String  @db.Text
  alt       String?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductPrice {
  id         String   @id @default(cuid())
  productId  String
  currencyId String
  amount     Decimal  @db.Decimal(12, 2)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  currency   Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)

  @@unique([productId, currencyId])
  @@index([currencyId])
}

/// A configurable payment provider (Stripe, PayPal, Afterpay, Klarna, Sequra,
/// manual transfer, …). New providers are added by writing an integration that
/// reads `config`; no schema change required. Linked to the currencies it
/// serves via GatewayCurrency — checkout shows only gateways whose currency
/// matches the visitor's resolved Currency.
model PaymentGateway {
  id        String  @id @default(cuid())
  /// Stable provider key resolved by the integration layer, e.g.
  /// "stripe", "paypal", "afterpay", "klarna", "sequra", "manual".
  /// NOT unique: a provider can have several instances with distinct
  /// credentials (e.g. a Stripe account per region — US vs. EU), each linked
  /// to the currencies it serves. Selection at checkout is by currency.
  provider  String
  name      String // display label shown to the buyer, e.g. "Tarjeta (Stripe)"
  enabled   Boolean @default(true)
  // false = test/sandbox credentials, true = live.
  live      Boolean @default(false)
  // Provider-specific credentials & options as JSON (api keys, secrets,
  // webhook ids, bank details for manual transfer, …). Encrypted at the app
  // layer before persisting. Defaults to "{}" in app code — MySQL TEXT
  // columns cannot carry a DEFAULT.
  config    String  @db.Text
  position  Int     @default(0) // display order at checkout
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currencies GatewayCurrency[]
  orders     Order[]

  @@index([enabled])
  @@index([provider])
}

/// Join: which currencies a gateway accepts.
model GatewayCurrency {
  gatewayId  String
  currencyId String
  gateway    PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  currency   Currency       @relation(fields: [currencyId], references: [id], onDelete: Cascade)

  @@id([gatewayId, currencyId])
  @@index([currencyId]) // resolve gateways by buyer currency
}

/// A buyer. Decoupled from User (admin accounts). Reused across orders by email.
model Customer {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String // given names
  surname     String? // family names
  phone       String?
  addressLine String? // street address
  city        String? // town / población
  postalCode  String?
  province    String? // provincia / state
  country     String? // ISO-3166 alpha-2
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@index([email])
}

enum OrderStatus {
  PENDING // created, awaiting payment
  PAID // gateway confirmed payment
  FULFILLED // delivered / academy access granted
  CANCELLED
  REFUNDED
  FAILED // payment attempt failed
}

/// A single purchase. Single-item flow (no cart): one product per order,
/// but items are modelled in OrderItem to keep totals explicit and allow
/// future multi-item support. Price & currency are snapshotted at purchase.
model Order {
  id         String      @id @default(cuid())
  // Atomic autoincrement backing the human-facing number: guarantees the
  // reference is unique and truly sequential (no random-collision risk).
  seq        Int         @unique @default(autoincrement())
  // Human-friendly sequential reference (TBS-000123) shown to the buyer. The
  // PUBLIC status URL keys off `id` (an unguessable cuid), NOT this number, so
  // orders can't be enumerated.
  number     String      @unique
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  currencyId String
  currency   Currency    @relation(fields: [currencyId], references: [id])
  total      Decimal     @db.Decimal(12, 2)
  status     OrderStatus @default(PENDING)
  // Which gateway is/was used. SetNull so deleting a gateway keeps order history.
  gatewayId  String?
  gateway    PaymentGateway? @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  // Provider's payment/session id for reconciliation against webhooks.
  paymentRef String?
  // Raw provider payload (last webhook/notification) for auditing.
  paymentMeta String? @db.Text
  paidAt     DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      OrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt]) // default sort
  @@index([gatewayId])
}

/// Line item with a snapshot of the product at purchase time (name/sku/price
/// stay fixed even if the product later changes or is deleted).
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Nullable FK so deleting a product doesn't erase order history.
  productId   String?
  productName String
  productSku  String?
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int     @default(1)

  @@index([orderId])
  @@index([productId])
}
