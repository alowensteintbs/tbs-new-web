generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  SUPERADMIN
  ADMIN
  COMERCIAL
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

model Page {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  figmaFileKey String
  figmaNodeId  String
  status       PageStatus @default(DRAFT)
  // SEO (replaces Rank Math per-page meta)
  metaTitle       String?
  metaDescription String? @db.Text
  ogImage         String?
  canonical       String?
  noindex         Boolean @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

/// Editable key/value site configuration (GTM id, default currency, etc.).
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// URL redirects (replaces the Redirection plugin). Applied in proxy.ts.
model Redirect {
  id         String   @id @default(cuid())
  from       String   @unique // incoming path, e.g. "/old-page"
  to         String // destination path or absolute URL
  statusCode Int      @default(301)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([enabled])
}

model Currency {
  id        String         @id @default(cuid())
  code      String         @unique // ISO 4217, e.g. EUR, MXN, USD
  name      String // e.g. "Euro"
  symbol    String // e.g. "€"
  enabled   Boolean        @default(true)
  // CSV of ISO-3166 alpha-2 country codes that resolve to this currency,
  // e.g. "MX" or "ES,IT,FR". Used to pick a currency by visitor country.
  countryCodes String @default("")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  prices    ProductPrice[]

  @@index([name]) // search by name (code is already unique-indexed)
  @@index([enabled]) // filter by status
}

/// Product category (editable from the admin panel).
model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  visible     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([visible])
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  sku         String?
  description String         @db.Text
  academyId   String         @default("") // external academy identifier
  visible     Boolean        @default(true)
  featured    Boolean        @default(false)
  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  prices      ProductPrice[]
  images      ProductImage[]

  @@index([name]) // search by name
  @@index([updatedAt]) // default sort
  @@index([slug])
  @@index([visible])
  @@index([categoryId])
}

/// Product image hosted on Bunny CDN.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String  @db.Text
  alt       String?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductPrice {
  id         String   @id @default(cuid())
  productId  String
  currencyId String
  amount     Decimal  @db.Decimal(12, 2)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  currency   Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)

  @@unique([productId, currencyId])
  @@index([currencyId])
}
